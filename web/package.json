{
  "name": "carbonature-mrv-web",
  "version": "0.1.0",
  "private": true,
  "description": "CarboNature AI Soil MRV Module — Tier 1 web client (runs on the mrv database).",
  "scripts": {
    "clean:conflicts": "node scripts/clean-sync-conflicts.mjs",
    "predev": "npm run clean:conflicts",
    "dev": "next dev",
    "prebuild": "npm run clean:conflicts && npm run check:sql",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:sql": "node scripts/check-db-queries.mjs",
    "db:doctor": "node scripts/db-doctor.mjs",
    "db:link": "node scripts/link-db.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:certs": "node scripts/fetch-rds-ca.mjs",
    "auth:google": "node scripts/set-oauth-secret.mjs",
    "agent:key": "node scripts/set-anthropic-key.mjs",
    "agent:key:voyage": "node scripts/set-voyage-key.mjs"
  },
  "dependencies": {
    "@turf/area": "^7.3.5",
    "docx": "^9.7.1",
    "mapbox-gl": "^3.24.1",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
