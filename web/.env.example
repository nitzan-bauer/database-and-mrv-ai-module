# ── CarboNature MRV module — environment ──────────────────────────────
# Copy to .env.local and fill in. .env.local is git-ignored.

# Connection to the live mrv database on AWS RDS (PostgreSQL 16 + PostGIS + pgvector).
# The app sets search_path=mrv,public on every connection.
# Leave BLANK to run in dev-fixtures mode (demo data, no DB needed).
DATABASE_URL=

# Data source: "db" (query RDS) or "fixtures" (built-in demo data).
# Defaults to "fixtures" automatically when DATABASE_URL is empty.
MRV_DATA_MODE=fixtures

# Mapbox GL JS access token (public). Reuse the SaaS token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Google Workspace SSO ──────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (type: Web application).
# Authorised redirect URI must be exactly:
#   http://localhost:3007/api/auth/callback/google      (development)
#   https://<your-domain>/api/auth/callback/google      (production)
# Leave blank to keep the labelled dev sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signs the session cookie. Generate with:  npx auth secret
AUTH_SECRET=

# Only this Google Workspace domain may sign in. Defaults to carbonature.io.
AUTH_ALLOWED_DOMAIN=carbonature.io

# ── Scheduled tasks (0073) ──────────────────────────────────────────────
# Checked against the Authorization: Bearer header on every request to
# /api/cron/run-scheduled-tasks — Vercel sends this automatically once
# CRON_SECRET is set as a Vercel env var. Generate any random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# Whose stored Google refresh token scheduled tasks authenticate with.
# Defaults to nitzan@carbonature.io if unset.
CRON_GOOGLE_ACCOUNT_EMAIL=

# ── Agent runtime ──────────────────────────────────────────────────────
# Anthropic key for the agents to actually call a model. Set with:
#   npm run agent:key
ANTHROPIC_API_KEY=

# Voyage AI key for agent-memory embeddings (record_agent_memory /
# recall_agent_memory). Set with:
#   npm run agent:key:voyage
VOYAGE_API_KEY=
