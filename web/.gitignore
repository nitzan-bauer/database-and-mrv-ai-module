# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
# Amazon's RDS root CA bundle is public, not a secret, and dbSsl.ts requires
# it to exist at build time (no fetch step runs during `vercel build`) — see
# scripts/fetch-rds-ca.mjs's own comment: "public, and committed".
!/certs/rds-global-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (secrets — never commit)
.env
.env*.local
.env.local
# ...and any backup or editor copy of one. `.env*.local` only matches names
# ending in .local, so .env.local.bak (written by scripts/set-oauth-secret.mjs)
# would otherwise be committable with the secret inside it.
.env.local.*
.env*.bak

# typescript
*.tsbuildinfo

# editor
.vscode/*
!.vscode/extensions.json

# local scratch: ad-hoc tsc output used when unit-checking modules
/.tsbuild

.vercel
