# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

region       = "eu-west-1"
environment  = "dev"
project_name = "carbonature-mrv"

# Your public IP as a /32, so migrations can run from your laptop.
# Find it with:  curl -s https://checkip.amazonaws.com
# 0.0.0.0/0 is rejected by a validation rule.
allowed_admin_cidrs = ["203.0.113.7/32"]

# dev sizing — see docs/STAGE-0.md for the cost breakdown
db_instance_class   = "db.t4g.micro"
db_multi_az         = false
publicly_accessible = true

# prod would instead be roughly:
#   environment              = "prod"
#   db_instance_class        = "db.t4g.small"
#   db_multi_az              = true
#   publicly_accessible      = false
#   allowed_admin_cidrs      = []
#   db_backup_retention_days = 30
